    - '// @input string bottleId = "metformin" {"hint":"Which bottle in the sample schedule this is.", "widget":"combobox", "values":[{"label":"Metformin 500 mg", "value":"metformin"}, {"label":"Amlodipine 5 mg", "value":"amlodipine"}, {"label":"Furosemide 20 mg", "value":"furosemide"}, {"label":"Atorvastatin 20 mg", "value":"atorvastatin"}, {"label":"Vitamin D", "value":"vitaminD"}]}'
