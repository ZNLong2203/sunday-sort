  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">SundaySortBoxOverlayUI – rings, counts, day labels and dots on the box</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 pillbox {"hint":"The pillbox whose cells this overlay sits on (source of cell positions)."}'
    - '// @input Asset.Material overlayMaterial {"hint":"Unlit material cloned for rings, pill icons and dots."}'
    - '// @input SceneObject cameraObject {"hint":"Camera Object — counts and labels turn to face it."}'
    - '// @input Asset.Texture tickIcon {"hint":"Tick icon shown on the box corner when the week is finished."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - "// @input vec4 ringColor = \"{0.2,0.95,1.0,1}\" {\"hint\":\"Colour of the ring around a lit cell's rim (brief: bright cyan).\", \"widget\":\"color\"}"
    - '// @input vec4 dayLitColor = "{0.35,0.97,1.0,1}" {"hint":"Colour of a day label when that day is lit.", "widget":"color"}'
    - '// @input float countHeightCm = 2 {"hint":"Height of the floating count digits in cm (brief: about 2 cm).", "widget":"slider", "min":1, "max":3.5, "step":0.1}'
    - '// @input float countLiftFrontCm = 4.3 {"hint":"How far above the rim the evening (front row) counts float, in cm. High enough to clear the back-edge labels and dots from where the user stands.", "widget":"slider", "min":0.5, "max":8, "step":0.1}'
    - "// @input float countLiftBackCm = 7 {\"hint\":\"How far above the rim the morning (back row) counts float, in cm. Higher than the front row so the rows don't overlap from 60 cm.\", \"widget\":\"slider\", \"min\":0.5, \"max\":10, \"step\":0.1}"
    - '// @input float dayLabelLiftCm = 0.8 {"hint":"Height of the centre of the MON..SUN labels above the back edge, in cm (they sit on the edge: keep it 2 cm or less).", "widget":"slider", "min":0.3, "max":2, "step":0.05}'
    - '// @input float dotLiftCm = 1.6 {"hint":"Height of the centre of the progress dots above the back edge, in cm (top of the dots stays within 2 cm).", "widget":"slider", "min":0.4, "max":1.6, "step":0.05}'
    - "// @input vec4 doseChangeColor = \"{1.0,0.55,0.12,1}\" {\"hint\":\"Doctor's change: colour of the pulsing rings, counts and label (bright orange).\", \"widget\":\"color\"}"
    - '// @ui {"widget":"group_end"}'
